function dateOf(slug: string): Date | null {
  const post = bySlug[slug];
  return post ? post.data.date : null;
}
function titleOf(slug: string): string {
  const post = bySlug[slug];
  return post ? post.data.title : slug;
}
function fmtDate(d: Date | null): string {
  if (!d) return "—";
  return d.toISOString().slice(0, 10);
}
---

<BaseLayout
  title="Series"
  description="Posts grouped into thematic reading orders. Pick a series and read top-to-bottom."
  active="writing"
  file="~/intrepidkarthi/series"
>
  <div class="content">
    <div class="pre-title"><span class="arrow">$</span> ls ~/writing/series/</div>
    <h1><span class="hash">#</span>series</h1>
    <p class="lede">
      The blog has 150+ posts. Most of them belong to a series — multiple posts on the same theme,
      meant to be read in order. Each series below is a coherent reading list, sorted chronologically.
    </p>

    {series.map((s) => (
      <section class="series-block" id={s.id}>
        <h2 class="series-head">
          <span class="hash">##</span> {s.title}
          <span class="count">· {s.entries.filter((e) => bySlug[e.slug]).length} posts</span>
        </h2>
        <p class="series-sub">{s.subtitle}</p>

        <ol class="series-list">
          {s.entries.map((e, i) => {
            const post = bySlug[e.slug];
            if (!post) return null;
            return (
              <li class="series-item">
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                <a href={`/writing/${e.slug}`}>{titleOf(e.slug)}</a>
                <span class="date">{fmtDate(dateOf(e.slug))}</span>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    <div class="footer-note">
      <span class="dim">→</span> Full chronological archive at <a href="/writing">/writing</a>.
    </div>
  </div>
</BaseLayout>

<style>
  .content { max-width: 900px; }
  .pre-title {
    color: var(--dim); font-size: 11px;
    text-transform: uppercase; letter-spacing: 2px;
    margin-bottom: 4px;
  }
  .pre-title .arrow { color: var(--green); }
  h1 {
    font-family: var(--font-vt); font-size: 36px; line-height: 1;
    color: var(--green-bright);
    text-shadow: 0 0 6px var(--green-glow);
    margin-bottom: 6px;
  }
  h1 .hash { color: var(--pink); margin-right: 8px; }
  .lede {
    color: var(--ink); margin-bottom: 36px;
    max-width: 720px;
  }

  .series-block { margin-bottom: 48px; }
  .series-head {
    font-family: var(--font-vt); font-size: 24px;
    color: var(--green-bright);
    text-shadow: 0 0 4px var(--green-glow);
    margin-bottom: 6px;
    scroll-margin-top: 80px;
  }
  .series-head .hash { color: var(--pink); margin-right: 8px; }
  .series-head .count {
    color: var(--dim); font-family: var(--font-mono);
    font-size: 13px; font-weight: 400;
    text-shadow: none;
    margin-left: 8px;
  }
  .series-sub {
    color: var(--dim); font-size: 14px;
    margin-bottom: 16px;
    max-width: 720px;
  }

  .series-list {
    list-style: none; padding: 0; margin: 0;
    border-top: 1px dashed var(--line);
  }
  .series-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px dashed var(--line);
  }
  .series-item .num {
    color: var(--dim); font-family: var(--font-mono);
    font-size: 11px;
  }
  .series-item a {
    color: var(--ink); text-decoration: none;
    border-bottom: 1px dashed transparent;
    font-size: 14px;
  }
  .series-item a:hover {
    color: var(--green-bright); border-bottom-color: var(--green);
  }
  .series-item .date {
    color: var(--dim); font-family: var(--font-mono);
    font-size: 11px; white-space: nowrap;
  }

  .footer-note {
    margin-top: 36px; padding-top: 18px;
    border-top: 1px dashed var(--line-bright);
    color: var(--dim); font-size: 13px;
  }
  .footer-note .dim { color: var(--green); }
  .footer-note a { color: var(--cyan); text-decoration: none;
    border-bottom: 1px dashed var(--cyan); }
</style>
